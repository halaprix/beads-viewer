{
  "name": "@halaprix/beads-viewer",
  "version": "0.0.1",
  "description": "Interactive dependency graph editor for Beads issues.",
  "keywords": [
    "beads",
    "bd",
    "issue-tracker",
    "dependency-graph",
    "dag",
    "local-first",
    "cli"
  ],
  "homepage": "https://github.com/halaprix/beads-viewer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halaprix/beads-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/halaprix/beads-viewer/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "beads-viewer": "./server/cli.mjs"
  },
  "files": [
    "server",
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "dev": "node server/cli.mjs --dev",
    "build": "vite build",
    "start": "node server/cli.mjs",
    "test": "node --test test/*.test.mjs && node --test --experimental-strip-types test/*.test.ts",
    "test:cli": "node --test test/cli.test.mjs",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@xyflow/react": "^12.11.2",
    "elkjs": "^0.12.0",
    "oxlint": "^1.40.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~7.0.2",
    "vite": "^8.0.0"
  }
}
